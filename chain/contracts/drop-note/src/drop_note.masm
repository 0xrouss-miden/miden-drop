use miden::protocol::active_account
use miden::protocol::account_id
use miden::protocol::active_note
use miden::protocol::tx
use miden::standards::wallets::basic as basic_wallet

const ERR_DROP_NOTE_UNEXPECTED_STORAGE="Miden Drop note expects exactly four storage items"
const ERR_DROP_NOTE_INVALID_EXPIRATION="Miden Drop note requires a recovery block"
const ERR_DROP_NOTE_INVALID_PAIR="Miden Drop Oracle condition only supports BTC/USD and ETH/USD"
const ERR_DROP_NOTE_INVALID_TARGET="Miden Drop Oracle condition requires a non-zero target price"
const ERR_DROP_NOTE_PARTIAL_CONDITION="Miden Drop must zero every Oracle field when price gating is disabled"
const ERR_DROP_NOTE_SENDER_LOCKED="Miden Drop sender cannot claim before the recovery block"
const ERR_DROP_NOTE_RECIPIENT_EXPIRED="Miden Drop expired and can only be reclaimed by its sender"
const ERR_DROP_NOTE_PRICE_UNAVAILABLE="Pragma pair is not tracked or has no fresh publisher value"
const ERR_DROP_NOTE_PRICE_DECIMALS="Pragma price decimals do not match the drop target"
const ERR_DROP_NOTE_PRICE_STALE="Pragma price timestamp is outside the 120-second freshness window"
const ERR_DROP_NOTE_PRICE_TOO_LOW="Pragma price has not reached the Miden Drop target"

#! Miden Drop optionally price-gated bearer note.
#!
#! Before the recovery block, a non-sender bearer may consume the note. When a price condition is
#! configured, Pragma's current BTC/USD or ETH/USD median must also be greater than or equal to the
#! configured raw target price. At and after the recovery block, the Oracle is skipped and only the
#! original sender may recover it.
#!
#! Pragma deployment pinned by this script:
#! - Oracle: 0x8f8d747477ca171144feadc60a1137
#! - get_median: 0x633ac6865a1c4c27f065c07439d59bffdcd931ed9a706abbe2ae70dcd76031ac
#!
#! Requires the consuming account to expose the standard Basic Wallet `receive_asset` procedure.
#!
#! Note storage:
#! - recovery_block: block height from which only the sender may consume the note.
#! - pair_prefix: 0 for no Oracle, 1 for BTC/USD, or 2 for ETH/USD.
#! - pair_suffix: 0 for no Oracle and both supported pairs.
#! - raw_target_price: 0 for no Oracle, otherwise the USD target scaled by 10^8.
#!
#! Inputs:  []
#! Outputs: []
@note_script
pub proc claim
    # Load the four immutable wager parameters into memory addresses 0..3.
    push.0 exec.active_note::get_storage
    eq.4 assert.err=ERR_DROP_NOTE_UNEXPECTED_STORAGE

    # Every drop must eventually become recoverable.
    mem_load.0 eq.0 assertz.err=ERR_DROP_NOTE_INVALID_EXPIRATION

    # A zeroed triplet disables the Oracle. Otherwise require one complete supported condition.
    mem_load.1 eq.0
    if.true
        mem_load.2 eq.0 assert.err=ERR_DROP_NOTE_PARTIAL_CONDITION
        mem_load.3 eq.0 assert.err=ERR_DROP_NOTE_PARTIAL_CONDITION
    else
        mem_load.2 eq.0 assert.err=ERR_DROP_NOTE_INVALID_PAIR
        mem_load.1 dup eq.1 swap eq.2 or assert.err=ERR_DROP_NOTE_INVALID_PAIR
        mem_load.3 eq.0 assertz.err=ERR_DROP_NOTE_INVALID_TARGET
    end

    # The recovery block is an exclusive boundary: recipient before, sender from it onward.
    mem_load.0 exec.tx::get_reference_block_number lte
    if.true
        exec.active_account::get_id
        exec.active_note::get_sender
        exec.account_id::eq assert.err=ERR_DROP_NOTE_RECIPIENT_EXPIRED
    else
        # The creating account is explicitly locked out during the recipient claim window.
        exec.active_account::get_id
        exec.active_note::get_sender
        exec.account_id::eq assertz.err=ERR_DROP_NOTE_SENDER_LOCKED

        # A zero pair prefix marks a plain bearer drop and skips all foreign-account work.
        mem_load.1 eq.0
        if.false
            # Oracle v1 takes the Poseidon2 hash of the canonical pair name.
            # The note's compact pair selectors remain 1 (BTC/USD) and 2 (ETH/USD).
            padw padw padw
            mem_load.1 eq.1
            if.true
                push.0xd189b4e9c38c367ba926ddb0044b781ca8fff18dcc10a0c75ff5600a1eb4d0eb
            else
                push.0x9a50f4137c634e0b384a87bea3a186e578e21274af6ae752230ead4631233e1d
            end

            # Select Pragma get_median and its deployed public Oracle account.
            push.0x633ac6865a1c4c27f065c07439d59bffdcd931ed9a706abbe2ae70dcd76031ac
            push.10344051962714658577.4971602104747636480
            exec.tx::execute_foreign_procedure

            # Oracle v1 returns [num_publishers, median_price, decimals, last_updated, pad(12)].
            # Cedar currently has one registered publisher. A paused/empty/stale
            # oracle returns no publishers, so it can never authorize a claim.
            eq.0 assertz.err=ERR_DROP_NOTE_PRICE_UNAVAILABLE
            swap push.8 assert_eq.err=ERR_DROP_NOTE_PRICE_DECIMALS

            # `lte` compares the second felt to the first: target <= median.
            mem_load.3 swap lte assert.err=ERR_DROP_NOTE_PRICE_TOO_LOW

            # Check the reported timestamp independently of the oracle's filtering.
            dup eq.0 assertz.err=ERR_DROP_NOTE_PRICE_STALE
            exec.tx::get_block_timestamp swap sub
            push.120 lte assert.err=ERR_DROP_NOTE_PRICE_STALE
            dropw dropw dropw
        end
    end

    exec.basic_wallet::move_note_assets_to_account
end
